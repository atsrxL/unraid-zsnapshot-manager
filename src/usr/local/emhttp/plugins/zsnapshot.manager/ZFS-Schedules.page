</style>
<div class="zsm-tabs"><a href="/Tools/ZFS-Snapshots">Snapshots</a><strong>Schedules</strong></div>
<?php if($message): ?><div class="zsm-ok"><?=zsm_h2($message)?></div><?php endif; ?>
<?php if($error): ?><div class="zsm-err"><?=zsm_h2($error)?></div><?php endif; ?>

<div class="zsm-card">
