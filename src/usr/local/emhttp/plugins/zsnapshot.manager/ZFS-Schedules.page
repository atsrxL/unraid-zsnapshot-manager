</div><p><button type="submit">Create policy</button></p>
</form>
<p><small>Examples: hourly <code>0 * * * *</code>, daily 03:00 <code>0 3 * * *</code>, weekly Sunday 03:00 <code>0 3 * * 0</code>. Retention only removes snapshots created by this exact policy and never removes held snapshots.</small></p>
</div>

<h3>Policies</h3>
<table class="zsm-table"><thead><tr><th>Name</th><th>Target</th><th>Cron</th><th>Retention</th><th>Recursive</th><th>Status</th><th>Actions</th></tr></thead><tbody>
<?php if(!$schedules): ?><tr><td colspan="7"><em>No policies configured</em></td></tr><?php endif; ?>
<?php foreach($schedules as $r): ?>
<tr><td><?=zsm_h2($r['name'] ?? '')?></td><td><?=zsm_h2($r['target'] ?? '')?></td><td><code><?=zsm_h2($r['cron'] ?? '')?></code></td><td>Keep <?= (int)($r['keep'] ?? 0) ?></td><td><?=!empty($r['recursive'])?'Yes':'No'?></td><td><?=!empty($r['enabled'])?'Enabled':'Disabled'?></td>
<td class="zsm-actions">
<form method="post"><input type="hidden" name="action" value="run"><input type="hidden" name="id" value="<?=zsm_h2($r['id'] ?? '')?>"><button type="submit">Run now</button></form>
<form method="post"><input type="hidden" name="action" value="toggle"><input type="hidden" name="id" value="<?=zsm_h2($r['id'] ?? '')?>"><button type="submit"><?=!empty($r['enabled'])?'Disable':'Enable'?></button></form>
<form method="post" onsubmit="return confirm('Delete this schedule? Existing snapshots are not deleted.');"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<?=zsm_h2($r['id'] ?? '')?>"><button type="submit">Delete</button></form>
</td></tr>
<?php endforeach; ?></tbody></table>

<h3>Generated cron</h3>
