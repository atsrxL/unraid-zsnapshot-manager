<?php
require_once '/usr/local/emhttp/plugins/zsnapshot.manager/include/lib.php';

function zsm_h2($v){ return htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8'); }
$message=''; $error='';
$schedules=zsm_load_schedules();

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action=(string)($_POST['action'] ?? '');
    if ($action==='add') {
        $target=trim((string)($_POST['target'] ?? ''));
        $cron=trim((string)($_POST['cron'] ?? ''));
        $keep=max(1,min(10000,(int)($_POST['keep'] ?? 24)));
        if (!zsm_valid_dataset($target)) $error='Invalid target dataset/zvol';
        elseif (!zsm_valid_cron($cron)) $error='Invalid cron expression (5 fields required)';
        else {
            $id=bin2hex(random_bytes(8));
            $schedules[]=[
                'id'=>$id,'name'=>trim((string)($_POST['name'] ?? 'Policy')) ?: 'Policy',
                'target'=>$target,'cron'=>$cron,'keep'=>$keep,
                'recursive'=>!empty($_POST['recursive']),'enabled'=>true,
                'notify'=>(($_POST['notify'] ?? 'failure')==='always' ? 'always' : 'failure')
            ];
            if (zsm_save_schedules($schedules)) $message='Schedule created'; else $error='Failed to save schedules';
        }
    } elseif ($action==='delete') {
        $id=(string)($_POST['id'] ?? '');
        $schedules=array_values(array_filter($schedules, fn($r)=>($r['id'] ?? '')!==$id));
        if (zsm_save_schedules($schedules)) $message='Schedule deleted'; else $error='Failed to save schedules';
    } elseif ($action==='toggle') {
        $id=(string)($_POST['id'] ?? '');
        foreach($schedules as &$r) if(($r['id'] ?? '')===$id) $r['enabled']=empty($r['enabled']);
        unset($r);
        if (zsm_save_schedules($schedules)) $message='Schedule updated'; else $error='Failed to save schedules';
    } elseif ($action==='run') {
        $id=preg_replace('/[^a-f0-9]/i','',(string)($_POST['id'] ?? ''));
        if($id==='') $error='Invalid policy id';
        else {
            $cmd='/usr/local/emhttp/plugins/zsnapshot.manager/scripts/zsm-scheduler ' . escapeshellarg($id) . ' 2>&1';
            exec($cmd,$out,$rc);
            if($rc===0) $message='Policy executed successfully'; else $error=trim(implode("\n",$out)) ?: 'Policy execution failed';
        }
    }
    $schedules=zsm_load_schedules();
}
$datasets=zsm_datasets();
?>
