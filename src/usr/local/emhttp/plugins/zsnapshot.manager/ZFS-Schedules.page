<script>
var zsmPolicies = <?=json_encode(array_values($schedules), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)?>;
var zsmWizardStep = 1;

function zsmTimeParts(id) {
  var value = document.getElementById(id).value || '00:00';
  var parts = value.split(':');
  return {h: parseInt(parts[0],10) || 0, m: parseInt(parts[1],10) || 0};
}
function zsmBuildCron() {
  var mode = document.getElementById('zsm-mode').value;
  var cron = '0 3 * * *';
  if (mode === 'minutes') {
    var n = parseInt(document.getElementById('zsm-minutes').value,10) || 15;
    cron = '*/' + n + ' * * * *';
  } else if (mode === 'hourly') {
    var minute = Math.max(0, Math.min(59, parseInt(document.getElementById('zsm-hourly-minute').value,10) || 0));
    cron = minute + ' * * * *';
  } else if (mode === 'daily') {
    var t = zsmTimeParts('zsm-daily-time'); cron = t.m + ' ' + t.h + ' * * *';
  } else if (mode === 'weekly') {
    var w = zsmTimeParts('zsm-weekly-time'); cron = w.m + ' ' + w.h + ' * * ' + document.getElementById('zsm-weekday').value;
  } else if (mode === 'monthly') {
    var mo = zsmTimeParts('zsm-monthly-time');
    var day = Math.max(1, Math.min(31, parseInt(document.getElementById('zsm-monthday').value,10) || 1));
    cron = mo.m + ' ' + mo.h + ' ' + day + ' * *';
  } else if (mode === 'custom') {
    cron = document.getElementById('zsm-custom-cron').value.trim();
  }
  document.getElementById('zsm-cron-value').value = cron;
  document.getElementById('zsm-cron-preview').textContent = cron || '(invalid/empty)';
  return cron.length > 0;
}
function zsmScheduleModeChanged() {
  var mode = document.getElementById('zsm-mode').value;
  document.querySelectorAll('.zsm-mode-fields').forEach(function(el){ el.classList.toggle('active', el.getAttribute('data-mode') === mode); });
  zsmBuildCron();
}
function zsmSetField(name, value) {
  var field = document.querySelector('#zsm-policy-form [name="' + name + '"]');
  if (!field) return;
  if (field.type === 'checkbox') field.checked = !!value;
  else field.value = value == null ? '' : value;
}
function zsmLoadCron(cron) {
  cron = String(cron || '0 3 * * *').trim();
  var parts = cron.split(/\s+/), mode = 'custom', match;
  if ((match = parts[0] && parts[0].match(/^\*\/(5|10|15|20|30)$/)) && parts.slice(1).join(' ') === '* * * *') {
    mode = 'minutes'; document.getElementById('zsm-minutes').value = match[1];
  } else if (/^\d+$/.test(parts[0] || '') && parts.slice(1).join(' ') === '* * * *') {
    mode = 'hourly'; document.getElementById('zsm-hourly-minute').value = parts[0];
  } else if (/^\d+$/.test(parts[0] || '') && /^\d+$/.test(parts[1] || '') && parts.slice(2).join(' ') === '* * *') {
    mode = 'daily'; document.getElementById('zsm-daily-time').value = String(parts[1]).padStart(2,'0') + ':' + String(parts[0]).padStart(2,'0');
  } else if (/^\d+$/.test(parts[0] || '') && /^\d+$/.test(parts[1] || '') && parts[2] === '*' && parts[3] === '*' && /^[0-6]$/.test(parts[4] || '')) {
    mode = 'weekly'; document.getElementById('zsm-weekday').value = parts[4]; document.getElementById('zsm-weekly-time').value = String(parts[1]).padStart(2,'0') + ':' + String(parts[0]).padStart(2,'0');
  } else if (/^\d+$/.test(parts[0] || '') && /^\d+$/.test(parts[1] || '') && /^\d+$/.test(parts[2] || '') && parts[3] === '*' && parts[4] === '*') {
    mode = 'monthly'; document.getElementById('zsm-monthday').value = parts[2]; document.getElementById('zsm-monthly-time').value = String(parts[1]).padStart(2,'0') + ':' + String(parts[0]).padStart(2,'0');
  } else {
    document.getElementById('zsm-custom-cron').value = cron;
  }
  document.getElementById('zsm-mode').value = mode;
  zsmScheduleModeChanged();
}
function zsmReviewPolicy() {
  zsmBuildCron();
  var form = document.getElementById('zsm-policy-form');
  var target = form.querySelector('[name=target]').value;
  var recursive = form.querySelector('[name=recursive]').checked ? ', recursive' : '';
  var r = ['hourly','daily','monthly','yearly'].map(function(tier){
    return tier.charAt(0).toUpperCase() + '=' + form.querySelector('[name=retention_' + tier + ']').value;
  }).join(', ');
  document.getElementById('zsm-policy-review').textContent = target + recursive + ' · ' + document.getElementById('zsm-cron-value').value + ' · ' + r;
}
function zsmShowWizardStep(step) {
  zsmWizardStep = Math.max(1, Math.min(3, step));
  document.querySelectorAll('.zsm-step,.zsm-step-pane').forEach(function(el){
    el.classList.toggle('active', parseInt(el.getAttribute('data-step'),10) === zsmWizardStep);
  });
  document.getElementById('zsm-wizard-back').hidden = zsmWizardStep === 1;
  document.getElementById('zsm-wizard-next').hidden = zsmWizardStep === 3;
  document.getElementById('zsm-wizard-save').hidden = zsmWizardStep !== 3;
  if (zsmWizardStep === 3) zsmReviewPolicy();
}
function zsmOpenWizard(policy) {
  var form = document.getElementById('zsm-policy-form');
  form.reset();
  zsmSetField('zsm_action', policy ? 'update' : 'add');
  zsmSetField('id', policy ? policy.id : '');
  zsmSetField('name', policy ? policy.name : 'Daily');
  if (policy) zsmSetField('target', policy.target);
  zsmSetField('notify', policy ? policy.notify : 'failure');
  zsmSetField('recursive', policy ? policy.recursive : false);
  var retention = policy && policy.retention ? policy.retention : {hourly:24,daily:7,monthly:12,yearly:3};
  ['hourly','daily','monthly','yearly'].forEach(function(tier){ zsmSetField('retention_' + tier, retention[tier] == null ? 0 : retention[tier]); });
  zsmLoadCron(policy ? policy.cron : '0 3 * * *');
  document.getElementById('zsm-wizard-title').textContent = policy ? 'Edit snapshot policy' : 'Create snapshot policy';
  document.getElementById('zsm-wizard-save').textContent = policy ? 'Save changes' : 'Create policy';
  document.getElementById('zsm-policy-wizard').hidden = false;
  zsmShowWizardStep(1);
  document.getElementById('zsm-policy-wizard').scrollIntoView({behavior:'smooth', block:'start'});
}
function zsmCloseWizard() {
  document.getElementById('zsm-policy-wizard').hidden = true;
}
function zsmPreparePolicyForm(form) {
  if (!form.reportValidity() || !zsmBuildCron()) return false;
  var arg = function(n, value){ form.elements.namedItem('#arg[' + n + ']').value = String(value == null ? '' : value); };
  arg(1, form.elements.zsm_action.value);
  arg(2, form.elements.id.value);
  arg(3, form.elements.name.value);
  arg(4, form.elements.target.value);
  arg(5, form.elements.cron.value);
  arg(6, form.elements.retention_hourly.value);
  arg(7, form.elements.retention_daily.value);
  arg(8, form.elements.retention_monthly.value);
  arg(9, form.elements.retention_yearly.value);
  arg(10, form.elements.recursive.checked ? '1' : '0');
  arg(11, form.elements.notify.value);
  var save = document.getElementById('zsm-wizard-save');
  save.disabled = true;
  save.textContent = 'Applying…';
  window.setTimeout(function(){ location.reload(); }, 1000);
  return true;
}

document.addEventListener('DOMContentLoaded', function(){
  document.querySelectorAll('#zsm-policy-form input, #zsm-policy-form select').forEach(function(el){ el.addEventListener('input', zsmBuildCron); el.addEventListener('change', zsmBuildCron); });
  document.getElementById('zsm-mode').addEventListener('change', zsmScheduleModeChanged);
  zsmScheduleModeChanged();
  document.getElementById('zsm-create-policy').addEventListener('click', function(){ zsmOpenWizard(null); });
  document.getElementById('zsm-wizard-cancel').addEventListener('click', zsmCloseWizard);
  document.getElementById('zsm-wizard-back').addEventListener('click', function(){ zsmShowWizardStep(zsmWizardStep - 1); });
  document.getElementById('zsm-wizard-next').addEventListener('click', function(){
    if (zsmWizardStep === 1 && !document.getElementById('zsm-policy-form').reportValidity()) return;
    zsmShowWizardStep(zsmWizardStep + 1);
  });
  document.querySelectorAll('.zsm-edit-policy').forEach(function(button){
    button.addEventListener('click', function(){
      var id = button.getAttribute('data-policy-id');
      var policy = zsmPolicies.find(function(row){ return row.id === id; });
      if (policy) zsmOpenWizard(policy);
    });
  });
  if (new URLSearchParams(window.location.search).get('create') === '1') zsmOpenWizard(null);

});
</script>
