<form method="post"><input type="hidden" name="action" value="add">
<div class="zsm-grid">
<label>Name<br><input type="text" name="name" value="Daily" required></label>
<label>Target<br><select name="target" required><?php foreach($datasets as $d): ?><option value="<?=zsm_h2($d['name'])?>"><?=zsm_h2($d['name'])?> (<?=zsm_h2($d['type'])?>)</option><?php endforeach; ?></select></label>
