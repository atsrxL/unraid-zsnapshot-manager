<script>
function zsmTimeParts(id) {
  var value = document.getElementById(id).value || '00:00';
  var parts = value.split(':');
  return {h: parseInt(parts[0],10) || 0, m: parseInt(parts[1],10) || 0};
}
function zsmBuildCron() {
  var mode = document.getElementById('zsm-mode').value;
  var cron = '0 3 * * *';
  if (mode === 'minutes') {
    var n = parseInt(document.getElementById('zsm-minutes').value,10) || 15;
    cron = '*/' + n + ' * * * *';
  } else if (mode === 'hourly') {
    var minute = Math.max(0, Math.min(59, parseInt(document.getElementById('zsm-hourly-minute').value,10) || 0));
    cron = minute + ' * * * *';
  } else if (mode === 'daily') {
    var t = zsmTimeParts('zsm-daily-time'); cron = t.m + ' ' + t.h + ' * * *';
  } else if (mode === 'weekly') {
    var w = zsmTimeParts('zsm-weekly-time'); cron = w.m + ' ' + w.h + ' * * ' + document.getElementById('zsm-weekday').value;
  } else if (mode === 'monthly') {
    var mo = zsmTimeParts('zsm-monthly-time');
    var day = Math.max(1, Math.min(31, parseInt(document.getElementById('zsm-monthday').value,10) || 1));
    cron = mo.m + ' ' + mo.h + ' ' + day + ' * *';
  } else if (mode === 'custom') {
    cron = document.getElementById('zsm-custom-cron').value.trim();
  }
  document.getElementById('zsm-cron-value').value = cron;
  document.getElementById('zsm-cron-preview').textContent = cron || '(invalid/empty)';
  return cron.length > 0;
}
function zsmScheduleModeChanged() {
  var mode = document.getElementById('zsm-mode').value;
  document.querySelectorAll('.zsm-mode-fields').forEach(function(el){ el.classList.toggle('active', el.getAttribute('data-mode') === mode); });
  zsmBuildCron();
}
function zsmScheduleStatus(text, kind) {
  var el = document.getElementById('zsm-schedule-status');
  el.textContent = text;
  el.className = 'zsm-status ' + kind;
  el.scrollIntoView({behavior:'smooth', block:'nearest'});
}

document.addEventListener('DOMContentLoaded', function(){
  document.querySelectorAll('#zsm-policy-form input, #zsm-policy-form select').forEach(function(el){ el.addEventListener('input', zsmBuildCron); el.addEventListener('change', zsmBuildCron); });
  document.getElementById('zsm-mode').addEventListener('change', zsmScheduleModeChanged);
  zsmScheduleModeChanged();

  document.querySelectorAll('.zsm-schedule-action').forEach(function(form){
    form.addEventListener('submit', async function(ev){
      ev.preventDefault();
      var confirmText = form.getAttribute('data-confirm');
      if (confirmText && !window.confirm(confirmText)) return;
      if (form.id === 'zsm-policy-form' && !zsmBuildCron()) {
        zsmScheduleStatus('Invalid cron expression.', 'err');
        return;
      }
      var button = form.querySelector('button[type=submit]');
      var oldText = button ? button.textContent : '';
      if (button) { button.disabled = true; button.textContent = 'Working…'; }
      zsmScheduleStatus('Applying schedule change…', 'busy');
      try {
        var response = await fetch('/plugins/zsnapshot.manager/schedule-action.php', {
          method:'POST', body:new FormData(form), credentials:'same-origin', cache:'no-store'
        });
        var text = await response.text();
        var data;
        try { data = JSON.parse(text); } catch(e) { throw new Error(text || ('HTTP ' + response.status)); }
        if (!response.ok || !data.ok) throw new Error(data.message || 'Schedule operation failed');
        zsmScheduleStatus(data.message || 'Schedule updated', 'ok');
        window.setTimeout(function(){ location.reload(); }, 250);
      } catch(e) {
        zsmScheduleStatus(e.message || String(e), 'err');
        if (button) { button.disabled = false; button.textContent = oldText; }
      }
    });
  });
});
</script>
