<script>
(function(){
  var buttons=Array.prototype.slice.call(document.querySelectorAll('.zsm-dataset-item'));
  var panels=Array.prototype.slice.call(document.querySelectorAll('[data-panel]'));
  function selectPanel(id,writeHash){
    if(!document.getElementById(id))return;
    panels.forEach(function(panel){panel.hidden=panel.id!==id;});
    buttons.forEach(function(button){var active=button.getAttribute('data-target')===id;button.classList.toggle('active',active);button.setAttribute('aria-current',active?'true':'false');});
    if(writeHash)history.replaceState(null,'','#'+id);
  }
  buttons.forEach(function(button){button.addEventListener('click',function(event){event.preventDefault();selectPanel(button.getAttribute('data-target'),true);});});
  var filter=document.getElementById('zsm-dataset-filter');
  if(filter)filter.addEventListener('input',function(){var needle=filter.value.trim().toLowerCase();buttons.forEach(function(button){button.hidden=needle!==''&&button.getAttribute('data-search').indexOf(needle)===-1;});});
  if(location.hash)selectPanel(location.hash.slice(1),false);
  window.addEventListener('hashchange',function(){if(location.hash)selectPanel(location.hash.slice(1),false);});
})();
</script>
