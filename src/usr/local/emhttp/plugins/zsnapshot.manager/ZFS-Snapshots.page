function zsm_h($v){ return htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); }
function zsm_bytes($n){
    $u=['B','KiB','MiB','GiB','TiB','PiB']; $i=0; $n=(float)$n;
    while($n>=1024 && $i<count($u)-1){$n/=1024;$i++;}
    return ($i===0 ? (string)(int)$n : number_format($n,2)) . ' ' . $u[$i];
}
function zsm_csrf_input($token){ return '<input type="hidden" name="csrf_token" value="'.zsm_h($token).'">'; }

$datasets = zsm_datasets();
$datasetMap = [];
foreach ($datasets as $datasetRow) $datasetMap[$datasetRow['name']] = $datasetRow;
$snapshots = zsm_snapshots();
$byDataset=[];
foreach($snapshots as $s) $byDataset[$s['dataset']][]=$s;
