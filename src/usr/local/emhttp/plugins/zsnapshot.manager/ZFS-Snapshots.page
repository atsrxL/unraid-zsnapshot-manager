function zsm_h($v){return htmlspecialchars((string)$v,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');}
function zsm_bytes($n){$u=['B','KiB','MiB','GiB','TiB','PiB'];$i=0;$n=(float)$n;while($n>=1024&&$i<count($u)-1){$n/=1024;$i++;}return ($i===0?(string)(int)$n:number_format($n,2)).' '.$u[$i];}
function zsm_csrf_input($token){return '<input type="hidden" name="csrf_token" value="'.zsm_h($token).'">';}
function zsm_dataset_anchor($dataset){return 'zsm-dataset-'.substr(hash('sha256',(string)$dataset),0,12);}

$datasets=zsm_datasets();
$datasetMap=[];foreach($datasets as $row)$datasetMap[$row['name']]=$row;
$snapshots=zsm_snapshots();
$byDataset=[];foreach($snapshots as $row)$byDataset[$row['dataset']][]=$row;
$visibleSnapshotCount=0;foreach($datasets as $row)$visibleSnapshotCount+=count($byDataset[$row['name']]??[]);
$selectedName=$datasets[0]['name']??'';
foreach($datasets as $row){if(!empty($byDataset[$row['name']])){$selectedName=$row['name'];break;}}
$showAll=(string)($_GET['all']??'')==='1';
$rowLimit=25;
