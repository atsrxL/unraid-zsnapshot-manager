<script>
(function(){
  function status(text, kind) {
    var el = document.getElementById('zsm-status');
    el.textContent = text;
    el.className = 'zsm-status ' + kind;
    el.scrollIntoView({behavior:'smooth', block:'nearest'});
  }

  document.querySelectorAll('.zsm-action-form').forEach(function(form){
    form.addEventListener('submit', async function(ev){
      ev.preventDefault();
      var confirmText = form.getAttribute('data-confirm');
      if (confirmText && !window.confirm(confirmText)) return;

      if (form.classList.contains('zsm-clone-form')) {
        var def = form.querySelector('input[name=clone_default]').value;
        var clone = window.prompt('Clone dataset name:', def);
        if (!clone) return;
        form.querySelector('input[name=clone]').value = clone;
      }

      var button = form.querySelector('button[type=submit]');
      var oldText = button ? button.textContent : '';
      if (button) { button.disabled = true; button.textContent = 'Working…'; }
      status('Running ZFS operation…', 'busy');

      try {
        var response = await fetch('/plugins/zsnapshot.manager/action.php', {
          method: 'POST',
          body: new FormData(form),
          credentials: 'same-origin',
          cache: 'no-store'
        });
        var text = await response.text();
        var data;
        try { data = JSON.parse(text); } catch(e) { throw new Error(text || ('HTTP ' + response.status)); }
        if (!response.ok || !data.ok) throw new Error(data.message || 'Operation failed');
        status(data.message || 'Operation completed', 'ok');
        window.setTimeout(function(){ location.reload(); }, 250);
      } catch (e) {
        status(e.message || String(e), 'err');
        if (button) { button.disabled = false; button.textContent = oldText; }
      }
    });
  });
})();
</script>
