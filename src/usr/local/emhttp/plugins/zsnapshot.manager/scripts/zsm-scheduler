#!/usr/bin/php
<?php

declare(strict_types=1);
require_once __DIR__ . '/../include/lib.php';

$id = (string)($argv[1] ?? '');
$force = (($argv[2] ?? '') === '--force');
if ($id === '') exit(2);

$policy = null;
foreach (zsm_load_schedules() as $row) {
    if (($row['id'] ?? '') === $id) {
        $policy = $row;
        break;
    }
}
if (!$policy) exit(2);
if (empty($policy['enabled']) && !$force) exit(0);

$lockPath = '/var/run/zsnapshot-manager-' . sha1($id) . '.lock';
$lock = @fopen($lockPath, 'c');
if (!$lock || !@flock($lock, LOCK_EX | LOCK_NB)) {
    $message = 'Policy is already running: ' . $id;
    zsm_log('SCHEDULE ' . $id . ' skipped: already running');
    if ($force) {
        fwrite(STDERR, "ERROR: {$message}\n");
        exit(1);
    }
    exit(0);
}
register_shutdown_function(static function () use ($lock): void {
    @flock($lock, LOCK_UN);
    @fclose($lock);
});

$target = (string)($policy['target'] ?? '');
if (!zsm_valid_dataset($target)) {
    zsm_log("SCHEDULE $id invalid target");
    exit(2);
}

$name = 'zsm-' . substr(preg_replace('/[^a-f0-9]/i', '', $id), 0, 8) . '-' . date('Ymd-His');
$recursive = !empty($policy['recursive']);
[$ok, $msg] = zsm_create_snapshot($target, $name, $recursive, 'schedule', $id);
if (!$ok) {
    zsm_log("SCHEDULE $id failed: $msg");
    zsm_notify('Scheduled snapshot failed', $target . ': ' . $msg, 'alert');
    exit(1);
}

$properties = implode(',', ['name', 'creation', ZSM_MANAGED_PROP, ZSM_POLICY_PROP]);
$out = zsm_exec([zsm_zfs_bin(), 'list', '-H', '-p', '-t', 'snapshot', '-o', $properties, '-S', 'creation', '-d', '1', $target], $rc);
if ($rc === 0 && $out !== '') {
    $managed = [];
    foreach (explode("\n", trim($out)) as $line) {
        $p = explode("\t", $line);
        if (count($p) < 4 || !zsm_valid_snapshot($p[0])) continue;
        [$ds, $snapName] = explode('@', $p[0], 2);
        if ($ds !== $target || $p[2] !== '1' || $p[3] !== $id) continue;
        $managed[] = ['full' => $p[0], 'name' => $snapName, 'creation' => (int)$p[1]];
    }

    $smart = (($policy['retention_mode'] ?? '') === 'smart') || isset($policy['retention']);
    $keepSet = [];
    if ($smart) {
        $retention = zsm_retention_counts((array)($policy['retention'] ?? []));
        if (array_sum($retention) === 0) {
            // All tiers disabled means retention/pruning is disabled. Keep everything.
            foreach ($managed as $row) $keepSet[$row['full']] = true;
        } else {
            $keepSet = zsm_smart_keep_set($managed, $retention);
        }
    } else {
        $keep = max(1, min(10000, (int)($policy['keep'] ?? 24)));
        foreach (array_slice($managed, 0, $keep) as $row) $keepSet[$row['full']] = true;
    }

    foreach ($managed as $old) {
        if (isset($keepSet[$old['full']])) continue;
        if ($recursive) {
            [$deleted, $reason] = zsm_delete_managed_generation($target, $old['name'], $id);
        } else {
            [$deleted, $reason] = zsm_delete_snapshot($old['full']);
        }
        if (!$deleted) zsm_log('RETENTION skip/fail ' . $old['full'] . ': ' . $reason);
    }
}

zsm_log("SCHEDULE $id completed: $msg");
if (($policy['notify'] ?? 'failure') === 'always') zsm_notify('Scheduled snapshot created', $msg, 'normal');
exit(0);
