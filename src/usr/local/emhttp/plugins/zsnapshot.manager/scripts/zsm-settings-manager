#!/usr/bin/php
<?php

declare(strict_types=1);
require_once dirname(__DIR__) . '/include/lib.php';

$value = strtolower((string)($argv[1] ?? ''));
$excluded = zsm_normalize_pool_names((string)($argv[2] ?? ''));
if (!in_array($value, ['yes', 'no'], true)) {
    fwrite(STDERR, "ERROR: Expected yes or no\n");
    exit(1);
}
if (!zsm_save_settings(['show_root_datasets' => $value === 'yes', 'excluded_pools' => $excluded])) {
    fwrite(STDERR, "ERROR: Failed to save settings\n");
    exit(1);
}
echo 'Root datasets are now ' . ($value === 'yes' ? 'shown' : 'hidden') . ".\n";
echo 'Excluded pools: ' . ($excluded ? implode(', ', $excluded) : 'none') . ".\n";
